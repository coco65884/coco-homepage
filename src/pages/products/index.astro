---
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const products = [
  {
    name: "Tokyo Master",
    href: `${base}/products/tokyo-master/`,
    description: "東京都の地理を学ぶためのアプリ",
    links: [
      {
        label: "Privacy Policy",
        href: `${base}/products/tokyo-master/privacy-policy/`,
      },
    ],
  },
];
---

<Base title="Products - coco">
  <h1>Products</h1>

  <ul class="product-list">
    {
      products.map((product) => (
        <li class="product-card">
          <h2>
            <a href={product.href}>{product.name}</a>
          </h2>
          <p>{product.description}</p>
          <div class="product-links">
            {product.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .product-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .product-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .product-card h2 {
    margin-top: 0;
  }

  .product-links {
    display: flex;
    gap: 1rem;
  }
</style>
